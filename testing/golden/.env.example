# Bake configuration for the Weblogin PSSO golden VM image.
# Copy to .env and override for your deployment. Values below are UiO's (upstream)
# defaults. .env is gitignored. Sourced by golden.sh and generate-psso-profile.sh.
# Shell syntax.

# --- Image identity ---
ORG="unioslo"
MACOS_VER="tahoe-26"                                     # tag suffix; see OPEN ITEM (pin exact base)
BASE_IMAGE="ghcr.io/cirruslabs/macos-tahoe-base:latest"  # OPEN ITEM: pin to a digest, not :latest
GOLDEN_LOCAL="weblogin-psso-golden-build"                # transient local Tart VM name during bake
GOLDEN_REMOTE="ghcr.io/${ORG}/weblogin-psso-test-vm:${MACOS_VER}"

# --- Guest access (cirruslabs base images ship admin/admin) ---
GUEST_USER="admin"
GUEST_PASS="admin"

# --- Extension identity (UiO's defaults, from Config/Deployment.xcconfig) ---
# The extension reads its managed prefs via CFPreferences with domain == its bundle id,
# so the PSSO payload MUST carry ClientID/BaseURL/Issuer/Audience under this identifier.
EXT_BUNDLE_ID="no.uio.WebloginSSO.ssoe"
APP_GROUP_ID="group.no.uio.weblogin"
TEAM_ID="L6H6YNBUBK"

# --- PSSO config keys the extension reads (Helpers.swift / AuthenticationViewController.swift) ---
# Defaults below match the mock IdP (testing/idp/mock_idp/__main__.py) and Keycloak's
# test realm client (testing/idp/keycloak/realm-export.json). For a real production
# bake, replace with the real ClientID/Issuer/Audience from that IdP's registration.
PSSO_CLIENT_ID="psso-client"
# PSSO_BASE_URL's hostname MUST be the extension's SSO host (SSO_HOST in
# Config/*.xcconfig, i.e. its authsrv associated-domains entitlement): macOS only
# activates the extension for URLs on a swcd-approved associated domain, MDM profile
# or not, and validation runs against the REAL host's AASA via Apple's CDN. The
# guest's /etc/hosts remaps this host to the mock IdP (which also listens on 443),
# so validation sees production while traffic goes to the mock. Standard port only.
PSSO_BASE_URL="https://weblogin2.uio.no"                 # your fork: its SSO_HOST
PSSO_ISSUER="https://idp.test/realms/test"
PSSO_AUDIENCE="psso-aud"

# --- Seams ---
IDP_HOST="idp.test"                                      # guest /etc/hosts maps this to the NAT gateway
CA_CRT="../idp/certs/ca.crt"                             # Plan 1 output, relative to testing/golden/

# --- Disposable MDM (bake-time only) ---
NANOMDM_URL="http://localhost:9002"                      # nanomdm enqueue/push API (host-local, behind mTLS proxy on 9000)
NANOMDM_API_KEY="testkey"                                # matches nanomdm/.env
MDM_APPROVE_TIMEOUT="600"                                # seconds to wait for the manual UAMDM approval (VNC)
